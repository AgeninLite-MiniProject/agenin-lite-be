meta {
  name: Search Users
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/admin/users?q=&page=0&size=5
  body: none
  auth: bearer
}

params:query {
  q: 
  page: 0
  size: 5
}

auth:bearer {
  token: {{jwt_token}}
}

vars:pre-request {
  jwt_token: eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiI4MDIxNGZlMy1iODhiLTQ3NWItYThlOC1lOTAzYjRiMmQ2MDUiLCJwaG9uZSI6Iis2MjgwMDAwMDAwMDAxIiwicm9sZSI6IkFETUlOIiwiaWF0IjoxNzgzNzUzNzM4LCJleHAiOjE3ODM3NTQ2Mzh9.MoX06q6F1WS8ggeq_2Nt19VpAmiFPRGNWXhxzUqAE798ykxBdPL0YjJtcYHu8IBKnu-ZIZhXbfHDscHka_XHDQ
