vars:pre-request {
  jwt_token: eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiI4MDIxNGZlMy1iODhiLTQ3NWItYThlOC1lOTAzYjRiMmQ2MDUiLCJwaG9uZSI6Iis2MjgwMDAwMDAwMDAxIiwicm9sZSI6IkFETUlOIiwiaWF0IjoxNzgzNjY0MjA5LCJleHAiOjE3ODM2NjUxMDl9.hKMwdjUbKQSBvBO7i9wNzUDviXSDkW3kZC0lYayVnXMCV2nsijkk1N3TN4n32NkL66YjDREdMiUCDf2eT5NScg
