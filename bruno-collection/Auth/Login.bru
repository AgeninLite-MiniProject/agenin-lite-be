meta {
  name: Login User
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "phone": "+628123322254",
    "password": "password321"
  }
}

vars:pre-request {
  base_url: http://localhost:8080
}

script:post-response {
  if (res.body && res.body.success) {
    bru.setEnvVar("jwt_token", res.body.data.accessToken);
    console.log("Token JWT berhasil disimpan ke Environment Bruno!");
  }
}

example {
  name: Login User
  
  request: {
    url: {{base_url}}/api/auth/login
    method: POST
    mode: json
    body:json: {
      {
        "phone": "+6281234567890",
        "password": "password123"
      }
    }
  }
  
  response: {
    headers: {
      x-content-type-options: nosniff
      x-xss-protection: 0
      cache-control: no-cache, no-store, max-age=0, must-revalidate
      pragma: no-cache
      expires: 0
      x-frame-options: DENY
      content-type: application/json
      transfer-encoding: chunked
      date: Thu, 09 Jul 2026 16:47:28 GMT
      keep-alive: timeout=60
      connection: keep-alive
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "message": "Login Successfull",
          "data": {
            "accessToken": "eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJkNDcwZGRhOC1hZjhkLTRhZDgtYTBkMS01NWRjMmY0YWI3MDMiLCJwaG9uZSI6Iis2MjgxMjM0NTY3ODkwIiwicm9sZSI6IkFHRU5UIiwiaWF0IjoxNzgzNjE1NjQ3LCJleHAiOjE3ODM2MTY1NDd9.cP5IugmgUbrYt4LDHzdYwsC9hgTnY-nb8JLWYIEIcjXES303r1OwKwc6kGTK5hD_AQ7rLQnPAzsDg2esdZ2HYQ",
            "refreshToken": "eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJkNDcwZGRhOC1hZjhkLTRhZDgtYTBkMS01NWRjMmY0YWI3MDMiLCJ0b2tlbklkIjoiODkzNTMzMjItNjgwOS00ZGI0LWE2NTQtNjE1OWY5NDJiNWEwIiwiaWF0IjoxNzgzNjE1NjQ3LCJleHAiOjE3ODQyMjA0NDd9.O1JkYC3k5G9kqRP6CBLA4w8Kn_7w-AHxf8CZf2wh6DAlxeRXDJf3MeeR-2_ddJB03TG7ek-d-zeBl7Ii0QkLMg",
            "tokenType": "Bearer"
          }
        }
      '''
    }
  }
}
