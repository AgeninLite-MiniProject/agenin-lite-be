meta {
  name: Create Product
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/admin/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "product_name": "Paket Teh",
    "cost_price": 3000.00,
    "selling_price": 5000.00,
    "agent_fee": 15.00,
    "super_agent_fee": 5.00
  }
}

vars:pre-request {
  base_url: http://localhost:8080
  jwt_token: eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiI4MDIxNGZlMy1iODhiLTQ3NWItYThlOC1lOTAzYjRiMmQ2MDUiLCJwaG9uZSI6Iis2MjgwMDAwMDAwMDAxIiwicm9sZSI6IkFETUlOIiwiaWF0IjoxNzgzNjE3MTU3LCJleHAiOjE3ODM2MTgwNTd9.DgmaDVFHSwMtaHiJqASuoxWauCnEUoQOKu0p3MbS7PgcYP3oKtXpZVqS2RemmzDexfAOSniTShozTU2vphDh4g
